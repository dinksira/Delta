# Public API base URL (no trailing slash). Leave empty to use same-origin relative paths.
NEXT_PUBLIC_API_BASE_URL=

# Optional local debug delay to force feed loading skeleton (milliseconds).
# Example: NEXT_PUBLIC_FEED_DEBUG_LOADING_MS=2000
NEXT_PUBLIC_FEED_DEBUG_LOADING_MS=0

# Optional local debug fallback: when backend returns no videos,
# show `public/mock-feed-videos` and use client-side mock actions/comments.
# Use only for local development.
NEXT_PUBLIC_FEED_DEBUG_USE_LOCAL_VIDEOS_WHEN_EMPTY=false

# Optional debug panel in feed right rail for worker lag/dead-letter health.
# Requires authenticated session (reads `/v1/feed/worker/health`).
NEXT_PUBLIC_FEED_DEBUG_WORKER_HEALTH=false
