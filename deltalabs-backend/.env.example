# Copy to `.env` and adjust. Do not commit real secrets.

ENV=local

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=deltalabs
# Optional pool / timeout tuning (defaults are safe for local dev)
# MONGODB_MAX_POOL_SIZE=100
# MONGODB_MIN_POOL_SIZE=0
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379/0
# REDIS_MAX_CONNECTIONS=50

# Shared outbound HTTP client (httpx)
# HTTP_TIMEOUT_SECONDS=30.0
# LOG_LEVEL=INFO

JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

API_V1_PREFIX=/v1
AUTHZ_DEFAULT_ORG_SLUG=delta-labs
AUTHZ_DEFAULT_ORG_NAME=Delta Labs
IDEMPOTENCY_HEADER_NAME=Idempotency-Key
# IDEMPOTENCY_TTL_SECONDS=86400

# Per-IP POST /v1/auth/* per minute (0 = off)
# RATE_LIMIT_AUTH_POSTS_PER_MINUTE=120
# Behind a reverse proxy, set true so X-Forwarded-For is honored for limits
# TRUST_X_FORWARDED_FOR=false
# Marketplace bid governance (0 disables where noted)
# MARKETPLACE_BID_COOLDOWN_SECONDS=60
# MARKETPLACE_BID_EXPIRY_HOURS=72
# MARKETPLACE_MAX_AMENDMENT_ROUNDS=3
# MARKETPLACE_BID_RATE_LIMIT_WINDOW_SECONDS=3600
# MARKETPLACE_BID_RATE_LIMIT_MAX_CREATES=20

# Media pipeline foundation (object storage + ingest callback contract)
# MEDIA_STORAGE_PROVIDER=s3
# MEDIA_STORAGE_BUCKET=delta-labs-media
# MEDIA_UPLOAD_BASE_URL=https://upload.example.com
# MEDIA_AWS_REGION=us-east-1
# MEDIA_S3_ENDPOINT_URL=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_UPLOAD_INTENT_TTL_SECONDS=900
# MEDIA_CDN_BASE_URL=https://cdn.example.com
# MEDIA_INGEST_SHARED_SECRET=replace-media-ingest-secret

# Cloudflare R2 plug-and-play example:
# MEDIA_STORAGE_PROVIDER=r2
# MEDIA_STORAGE_BUCKET=delta-labs-media
# MEDIA_AWS_REGION=auto
# MEDIA_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# MEDIA_S3_ACCESS_KEY_ID=<r2-access-key-id>
# MEDIA_S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# MEDIA_UPLOAD_INTENT_TTL_SECONDS=900
# MEDIA_CDN_BASE_URL=https://<your-cdn-domain>
# MEDIA_INGEST_SHARED_SECRET=<strong-shared-secret>

# Comma-separated list
CORS_ORIGINS=http://localhost:3000

APP_NAME=Delta Labs API
API_VERSION=0.1.0
